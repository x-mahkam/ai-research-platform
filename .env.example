# =============================================================================
# AI PROVIDERS
# The platform supports five AI providers. You only need ONE to use the AI
# features — set the key(s) for the provider(s) you want, leave the rest blank.
# Each experiment picks which configured provider(s) to use; selecting more than
# one runs them in parallel and combines their answers (ensemble mode).
# With NO key set, the AI features return a clearly-labeled built-in fallback.
# =============================================================================

# Google Gemini — has a genuinely FREE tier (no card). https://aistudio.google.com/apikey
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-2.5-flash"

# DeepSeek — very cheap, strong at math/physics. https://platform.deepseek.com
# DEEPSEEK_API_KEY="..."
# DEEPSEEK_MODEL="deepseek-chat"

# ChatGPT / OpenAI — https://platform.openai.com/api-keys (requires billing)
# OPENAI_API_KEY="..."
# OPENAI_MODEL="gpt-4o-mini"

# Grok / xAI — https://console.x.ai (requires billing)
# XAI_API_KEY="..."
# GROK_MODEL="grok-2-latest"

# Claude / Anthropic — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY="..."
# ANTHROPIC_MODEL="claude-opus-5"

# AI_PROVIDER: default provider id when an experiment doesn't pin one
# (gemini | deepseek | openai | grok | claude). Defaults to the first configured.
# AI_PROVIDER="gemini"

# AI_MAX_TOKENS: Max output tokens per AI response (default: 16000).
# AI_MAX_TOKENS="16000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# COMSOL_EXECUTABLE: Absolute path to comsolbatch(.exe) for running COMSOL models
# on this machine. Only needed if COMSOL is installed in a non-standard location
# (standard Program Files installs are auto-detected). Point it at the binary,
# or at the folder that contains it. Example (Windows, custom install):
# COMSOL_EXECUTABLE="D:\INSTALL\COMSOL Multiphysics v6.3.0.290_USTANOVKA\COMSOL63\Multiphysics\bin\win64\comsolbatch.exe"

# DATABASE_URL: Where the SQLite data lives.
# - Unset (default): a local file at storage/arp.db. Great for local dev and any
#   host with a persistent disk.
# - On ephemeral hosts (e.g. Render's free tier) the local disk is wiped on every
#   deploy. Point this at a libSQL/Turso database so data survives restarts:
#     DATABASE_URL="libsql://<your-db>.turso.io"
#     DATABASE_AUTH_TOKEN="<your-turso-token>"
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
