# ANTHROPIC_API_KEY: Required for the AI assistant / analysis to actually call
# Claude. Without it, the AI features return a clearly-labeled built-in fallback
# (not AI output). Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# ANTHROPIC_MODEL: Which Claude model to use (default: claude-opus-5).
# ANTHROPIC_MODEL="claude-opus-5"

# ANTHROPIC_MAX_TOKENS: Max output tokens per AI response (default: 16000).
# ANTHROPIC_MAX_TOKENS="16000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# COMSOL_EXECUTABLE: Absolute path to comsolbatch(.exe) for running COMSOL models
# on this machine. Only needed if COMSOL is installed in a non-standard location
# (standard Program Files installs are auto-detected). Point it at the binary,
# or at the folder that contains it. Example (Windows, custom install):
# COMSOL_EXECUTABLE="D:\INSTALL\COMSOL Multiphysics v6.3.0.290_USTANOVKA\COMSOL63\Multiphysics\bin\win64\comsolbatch.exe"

# DATABASE_URL: Where the SQLite data lives.
# - Unset (default): a local file at storage/arp.db. Great for local dev and any
#   host with a persistent disk.
# - On ephemeral hosts (e.g. Render's free tier) the local disk is wiped on every
#   deploy. Point this at a libSQL/Turso database so data survives restarts:
#     DATABASE_URL="libsql://<your-db>.turso.io"
#     DATABASE_AUTH_TOKEN="<your-turso-token>"
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
